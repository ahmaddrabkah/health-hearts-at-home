<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Toggle pill buttons used in the language switcher -->
    <style name="Widget.HH.LanguagePill" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">44dp</item>

        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>

        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/hh_on_primary</item>

        <item name="backgroundTint">@color/lang_pill_bg_selector</item>
        <item name="android:textColor">@color/lang_pill_text_selector</item>
        <item name="rippleColor">@color/hh_accent</item>
    </style>

    <!-- ============================================================
         Compatibility shape styles
         Some layouts reference Material3 / generic ShapeAppearanceOverlay styles.
         These stubs prevent AAPT linking errors without adding Material3.
         ============================================================ -->

    <!-- Base name referenced directly -->
    <style name="ShapeAppearanceOverlay">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <!-- Material3 base -->
    <style name="ShapeAppearanceOverlay.Material3" parent="ShapeAppearanceOverlay" />

    <!-- Material3 corner overlay -->
    <style name="ShapeAppearanceOverlay.Material3.Corner" parent="ShapeAppearanceOverlay.Material3" />

    <!-- Fully rounded (circle/pill) -->
    <style name="ShapeAppearanceOverlay.Material3.Corner.Full" parent="ShapeAppearanceOverlay.Material3">
        <item name="cornerSize">50%</item>
    </style>

</resources>
