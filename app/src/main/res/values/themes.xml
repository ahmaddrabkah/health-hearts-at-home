<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.HealthHearts" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/hh_primary</item>
        <item name="colorPrimaryVariant">@color/hh_primary</item>
        <item name="colorOnPrimary">@color/hh_on_primary</item>
        <item name="android:statusBarColor">@color/hh_primary</item>
        <item name="android:windowBackground">@color/hh_background</item>
    </style>

    <style name="Theme.HealthHearts.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hh_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.HealthHearts</item>
    </style>

</resources>
